<Project>
	<PropertyGroup>
		<IlcToolsPath>/home/nikita/Workspace/runtime/artifacts/bin/coreclr/linux.x64.Debug/x64/ilc/</IlcToolsPath>
		<IlcSdkPath>/home/nikita/Workspace/runtime/artifacts/bin/coreclr/linux.x64.Debug/aotsdk/</IlcSdkPath>
		<IlcFrameworkNativePath>/home/nikita/Workspace/runtime/artifacts/bin/microsoft.netcore.app.runtime.linux-x64/Release/runtimes/linux-x64/native/</IlcFrameworkNativePath>
		<EnableNativeSanitizers>address</EnableNativeSanitizers>
	</PropertyGroup>
	<ItemGroup>
		    <DirectPInvoke Include="libc" Condition="!$(RuntimeIdentifier.StartsWith('win'))" />
		    <CustomLinkerArg Include="-fsanitize=address" />
	</ItemGroup>
</Project>
