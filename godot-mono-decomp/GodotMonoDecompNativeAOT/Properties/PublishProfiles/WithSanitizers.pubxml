<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
	<Import Project="AOT.pubxml" />
	<PropertyGroup Condition="'$(DotNetRuntimeSdkDir)' != ''">
		<IlcToolsPath>$(DotNetRuntimeSdkDir)/ilc/</IlcToolsPath>
		<IlcSdkPath>$(DotNetRuntimeSdkDir)/aotsdk/</IlcSdkPath>
		<IlcFrameworkNativePath>$(DotNetRuntimeSdkDir)/native/</IlcFrameworkNativePath>
	</PropertyGroup>
	<ItemGroup>
		<DirectPInvoke Include="libc" Condition="!$(RuntimeIdentifier.StartsWith('win'))" />
		<CustomLinkerArg Include="-fsanitize=address" Condition="'$(UseASAN)' == 'true'" />
		<CustomLinkerArg Include="-fsanitize=leak" Condition="'$(UseLSAN)' == 'true'" />
		<CustomLinkerArg Include="-fsanitize=thread" Condition="'$(UseTSAN)' == 'true'" />
		<CustomLinkerArg Include="-fsanitize=memory" Condition="'$(UseMSAN)' == 'true'" />
		<CustomLinkerArg Include="-fsanitize=undefined" Condition="'$(UseUBSAN)' == 'true'" />
	</ItemGroup>
	<Import Project="$(DotNetRuntimeSdkDir)/eng/nativeSanitizers.targets" Condition="'$(DotNetRuntimeSdkDir)' != '' and Exists('$(DotNetRuntimeSdkDir)/eng/nativeSanitizers.targets')" />
</Project>
